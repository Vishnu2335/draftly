# ==============================================================================
# Draftly Frontend Environment Configuration (Template)
# Copy this file to .env.local for local development.
# NEVER commit real .env files containing secrets to Git!
# ==============================================================================

# Backend FastAPI Service Base URL (REQUIRED)
# For Local Development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# For Vercel Production Deployment:
# Set NEXT_PUBLIC_API_URL in Vercel Project Settings -> Environment Variables.
# IMPORTANT:
# 1. Use your Render backend service URL (e.g., https://draftly-backend.onrender.com)
# 2. DO NOT use your Supabase URL (https://xyz.supabase.co)
# 3. DO NOT include trailing slashes or duplicate /api prefixes
# Example for Vercel:
# NEXT_PUBLIC_API_URL=https://draftly-backend.onrender.com
