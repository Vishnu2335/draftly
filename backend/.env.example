# ==============================================================================
# Draftly Backend Environment Configuration (Template)
# Copy this file to .env and provide your actual credentials.
# NEVER commit the active .env file to Git!
# ==============================================================================

# Application Settings
ENVIRONMENT=development
PROJECT_NAME=Draftly
API_V1_STR=/api/v1

# Supabase PostgreSQL Connection String
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres?ssl=require
# Or connection pooler: postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:6543/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your-project.supabase.co:5432/postgres?ssl=require

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
